# --- Server ---
PORT=4000
# HOST defaults to 0.0.0.0 (all interfaces) so phones on the same WiFi can connect.
# To reach it from your phone, add your PC's LAN address to FRONTEND_ORIGIN,
# e.g. FRONTEND_ORIGIN=http://localhost:4000,http://192.168.1.10:4000
HOST=0.0.0.0
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:4000

# --- PostgreSQL ---
# Either set DATABASE_URL, or the individual PG* vars below.
DATABASE_URL=postgresql://boost_user:boost_password@localhost:5432/boost_db
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=boost_db
# PGUSER=boost_user
# PGPASSWORD=boost_password

# --- Auth ---
# Generate a strong random value, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_generated_secret
JWT_EXPIRES_IN=8h
COOKIE_NAME=boost_token

# --- Password reset email (optional) ---
# With no SMTP settings the server prints the reset link to its own console and,
# in development only, also returns it to the page that asked for it. Set
# SMTP_HOST (and the rest) to send real mail instead.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your.address@gmail.com
# SMTP_PASS=your-app-password
# MAIL_FROM="BOOST Procurement <your.address@gmail.com>"
# Base URL used to build the link in the email. Defaults to the address the
# request came in on, which is right when BOOST is reached by hostname.
# PUBLIC_URL=http://localhost:4000

# --- Seed script (backend/scripts/seed.js) ---
# Used only to create a local test client account. Not for production use.
SEED_EMAIL=client@boost.local
SEED_PASSWORD=change_me_before_seeding
SEED_FULL_NAME=Test Client

# --- OCR (mobile document scanner) ---
# Language the scanner reads. `eng` is installed by `npm run ocr:setup`; other
# traineddata files can be dropped into backend/langdata if you need them.
OCR_LANG=eng
# Where uploaded scans are written. Defaults to backend/uploads.
# UPLOAD_DIR=./uploads
