# --- Server ---
PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:4000

# --- PostgreSQL ---
# Either set DATABASE_URL, or the individual PG* vars below.
DATABASE_URL=postgresql://boost_user:boost_password@localhost:5432/boost_db
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=boost_db
# PGUSER=boost_user
# PGPASSWORD=boost_password

# --- Auth ---
# Generate a strong random value, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_generated_secret
JWT_EXPIRES_IN=8h
COOKIE_NAME=boost_token

# --- Seed script (backend/scripts/seed.js) ---
# Used only to create a local test client account. Not for production use.
SEED_EMAIL=client@boost.local
SEED_PASSWORD=change_me_before_seeding
SEED_FULL_NAME=Test Client
